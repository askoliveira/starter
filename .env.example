# Kinde
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=
KINDE_REDIRECT_URL=http://localhost:5173/api/auth/kinde_callback
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:5173
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:5173

# LEAVE EMPTY unless you have registered an API in Kinde.
# A non-empty placeholder value fails OAuth with "invalid_request: audience not whitelisted".
KINDE_AUDIENCE=

KINDE_SCOPE=profile email offline openid

# Set true locally to enable /api/auth/health to return diagnostic JSON.
# Remove or set false in production.
KINDE_DEBUG=true

# Supabase
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
